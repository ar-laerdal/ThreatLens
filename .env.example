# Copy to .env and fill in. Never commit .env.
# Which service runs Claude for the AI modes: anthropic (default) | bedrock | foundry
LLM_PROVIDER=anthropic

# --- anthropic: the Anthropic API directly ---
ANTHROPIC_API_KEY=your-key-here

# --- bedrock: Amazon Bedrock ---
# Region is required. Credentials come from the normal AWS chain (AWS_PROFILE, access keys, SSO, an IAM role)
# or from a Bedrock API key in AWS_BEARER_TOKEN_BEDROCK. Install boto3 to use profiles, SSO or roles.
# The model must be enabled for your account in the Bedrock console.
# AWS_REGION=us-east-1
# AWS_PROFILE=
# AWS_BEARER_TOKEN_BEDROCK=

# --- foundry: Microsoft Foundry ---
# Your Foundry resource name, plus either an API key or Microsoft Entra ID sign-in (pip install azure-identity).
# Example (made-up values, replace with yours):
#   endpoint https://contoso-foundry.services.ai.azure.com/anthropic/  ->  resource is "contoso-foundry"
# ANTHROPIC_FOUNDRY_RESOURCE=contoso-foundry
# ANTHROPIC_FOUNDRY_API_KEY=0123456789abcdef0123456789abcdef
# ANTHROPIC_FOUNDRY_AUTH=entra

# Optional overrides
# Model ID (Bedrock: anthropic.claude-sonnet-5-5) or, on Foundry, the name of your deployment.
# Defaults: claude-sonnet-5-5 (anthropic, foundry) / anthropic.claude-sonnet-5-5 (bedrock).
# LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
LOG_LEVEL=INFO

# Optional: fetch private Confluence pages from the Upload page (credentials are only used for private pages,
# and only sent to the host in CONFLUENCE_BASE_URL)
# CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
# Atlassian Cloud: email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
# Data Center / Server: leave CONFLUENCE_EMAIL empty and set a personal access token
# CONFLUENCE_EMAIL=you@company.com
# CONFLUENCE_API_TOKEN=
